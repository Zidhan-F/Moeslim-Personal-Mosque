# Salin berkas ini menjadi .env.production di VPS (JANGAN pernah commit .env.production ke git).

# Domain publik untuk HTTPS otomatis oleh Caddy (tanpa https://)
API_DOMAIN=api.namadomain.id

APP_NAME="Moeslim Mosque"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.namadomain.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

BCRYPT_ROUNDS=12

# PostgreSQL (otomatis terhubung ke service 'db' di docker-compose.prod.yml)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=moeslim
DB_USERNAME=moeslim
DB_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_KUAT

# Redis untuk cache, session, rate limit, dan queue worker
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Email SMTP (wajib agar kode verifikasi 6 digit masuk ke inbox pengguna)
# Contoh gratis/murah: Brevo (smtp-relay.brevo.com:587), Resend (smtp.resend.com:587), atau Gmail App Password
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@namadomain.id"
MAIL_FROM_NAME="Moeslim PM"

# Penyimpanan lampiran transaksi & gambar QRIS:
# 'local' memakai Docker volume app_storage di VPS (aman saat container restart).
# Untuk produksi besar, pasang league/flysystem-aws-s3-v3 lalu ubah ke 's3' (Cloudflare R2 gratis 10 GB).
FILESYSTEM_DISK=local
ATTACHMENTS_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Verifikasi langganan Google Play (kosong = nonaktif, endpoint verify mengembalikan 503)
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
