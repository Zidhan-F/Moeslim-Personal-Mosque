[{"s":109,"a":1,"t":"قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","tr":"Katakanlah: \"Hai orang-orang kafir,","tj":[[7,8,13],[18,19,0],[23,24,13],[28,29,17]]},{"s":109,"a":2,"t":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","tr":"Aku tidak akan menyembah apa yang kamu sembah.","tj":[[2,4,14],[26,27,17]]},{"s":109,"a":3,"t":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","tr":"Dan kamu bukan penyembah Tuhan yang aku sembah.","tj":[[4,6,14],[9,12,9],[17,18,13],[28,30,14],[37,38,12]]},{"s":109,"a":4,"t":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","tr":"Dan aku tidak pernah menjadi penyembah apa yang kamu sembah,","tj":[[4,6,14],[20,26,4],[32,33,6]]},{"s":109,"a":5,"t":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","tr":"dan kamu tidak pernah (pula) menjadi penyembah Tuhan yang aku sembah.","tj":[[4,6,14],[9,12,9],[17,18,13],[28,30,14],[37,38,12]]},{"s":109,"a":6,"t":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","tr":"Untukmu agamamu, dan untukkulah, agamaku\".","tj":[[26,27,17]]}]