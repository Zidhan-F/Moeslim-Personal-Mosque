[{"s":101,"a":1,"t":"ٱلْقَارِعَةُ","tr":"Hari Kiamat,"},{"s":101,"a":2,"t":"مَا ٱلْقَارِعَةُ","tr":"apakah hari Kiamat itu?","tj":[[4,5,0]]},{"s":101,"a":3,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","tr":"Tahukah kamu apakah hari Kiamat itu?","tj":[[4,6,14],[9,11,12],[14,15,13],[22,23,0]]},{"s":101,"a":4,"t":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","tr":"Pada hari itu manusia adalah seperti anai-anai yang bertebaran,","tj":[[15,16,0],[16,17,1],[17,20,3],[26,27,0],[37,38,0],[42,44,12],[46,47,17]]},{"s":101,"a":5,"t":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","tr":"dan gunung-gunung adalah seperti bulu yang dihambur-hamburkan.","tj":[[10,11,0],[23,24,0],[33,34,0],[38,41,9],[41,42,17]]},{"s":101,"a":6,"t":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","tr":"Dan adapun orang-orang yang berat timbangan (kebaikan)nya,","tj":[[4,7,3],[11,15,9],[26,27,13]]},{"s":101,"a":7,"t":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","tr":"maka dia berada dalam kehidupan yang memuaskan.","tj":[[17,23,5]]},{"s":101,"a":8,"t":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","tr":"Dan adapun orang-orang yang ringan timbangan (kebaikan)nya,","tj":[[4,7,3],[26,27,13]]},{"s":101,"a":9,"t":"فَأُمُّهُۥ هَاوِيَةٌۭ","tr":"maka tempat kembalinya adalah neraka Hawiyah.","tj":[[4,7,3],[9,10,13]]},{"s":101,"a":10,"t":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","tr":"Tahukah kamu apakah neraka Hawiyah itu?","tj":[[4,6,14],[9,11,12],[14,15,13]]},{"s":101,"a":11,"t":"نَارٌ حَامِيَةٌۢ","tr":"(Yaitu) api yang sangat panas."}]