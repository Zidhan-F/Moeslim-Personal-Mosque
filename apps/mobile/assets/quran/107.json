[{"s":107,"a":1,"t":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","tr":"Tahukah kamu (orang) yang mendustakan agama?"},{"s":107,"a":2,"t":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","tr":"Itulah orang yang menghardik anak yatim,"},{"s":107,"a":3,"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","tr":"dan tidak menganjurkan memberi makan orang miskin."},{"s":107,"a":4,"t":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","tr":"Maka kecelakaanlah bagi orang-orang yang shalat,"},{"s":107,"a":5,"t":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","tr":"(yaitu) orang-orang yang lalai dari shalatnya,"},{"s":107,"a":6,"t":"ٱلَّذِينَ هُمْ يُرَآءُونَ","tr":"orang-orang yang berbuat riya,"},{"s":107,"a":7,"t":"وَيَمْنَعُونَ ٱلْمَاعُونَ","tr":"dan enggan (menolong dengan) barang berguna."}]