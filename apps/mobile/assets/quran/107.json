[{"s":107,"a":1,"t":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","tr":"Tahukah kamu (orang) yang mendustakan agama?","tj":[[11,12,0],[31,32,0],[32,33,1],[36,37,17]]},{"s":107,"a":2,"t":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","tr":"Itulah orang yang menghardik anak yatim,","tj":[[4,5,13],[10,11,0],[26,27,0],[33,34,17]]},{"s":107,"a":3,"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","tr":"dan tidak menganjurkan memberi makan orang miskin.","tj":[[29,30,0],[38,39,17]]},{"s":107,"a":4,"t":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","tr":"Maka kecelakaanlah bagi orang-orang yang shalat,","tj":[[7,13,5],[22,23,17]]},{"s":107,"a":5,"t":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","tr":"(yaitu) orang-orang yang lalai dari shalatnya,","tj":[[17,21,9],[36,37,17]]},{"s":107,"a":6,"t":"ٱلَّذِينَ هُمْ يُرَآءُونَ","tr":"orang-orang yang berbuat riya,","tj":[[19,21,15],[23,24,17]]},{"s":107,"a":7,"t":"وَيَمْنَعُونَ ٱلْمَاعُونَ","tr":"dan enggan (menolong dengan) barang berguna.","tj":[[14,15,0],[22,23,17]]}]