[{"s":104,"a":1,"t":"وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","tr":"Kecelakaanlah bagi setiap pengumpat lagi pencela,","tj":[[5,11,5],[24,30,5]]},{"s":104,"a":2,"t":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","tr":"yang mengumpulkan harta dan menghitung-hitung,","tj":[[19,25,4]]},{"s":104,"a":3,"t":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","tr":"dia mengira bahwa hartanya itu dapat mengkekalkannya,","tj":[[11,14,3],[22,24,14]]},{"s":104,"a":4,"t":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","tr":"sekali-kali tidak! Sesungguhnya dia benar-benar akan dilemparkan ke dalam Huthamah.","tj":[[14,16,11],[19,22,3],[27,28,0]]},{"s":104,"a":5,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","tr":"Dan tahukah kamu apa Huthamah itu?","tj":[[4,6,14],[9,11,12],[14,15,13],[22,23,0]]},{"s":104,"a":6,"t":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","tr":"(yaitu) api (yang disediakan) Allah yang dinyalakan,","tj":[[6,7,0],[14,15,0]]},{"s":104,"a":7,"t":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","tr":"yang (membakar) sampai ke hati.","tj":[[24,25,0]]},{"s":104,"a":8,"t":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","tr":"Sesungguhnya api itu ditutup rapat atas mereka,","tj":[[2,5,3],[17,22,8]]},{"s":104,"a":9,"t":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","tr":"(sedang mereka itu) diikat pada tiang-tiang yang panjang.","tj":[[9,15,4]]}]