[{"s":114,"a":1,"t":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","tr":"Katakanlah: \"Aku berlindung kepada Tuhan (yang memelihara dan menguasai) manusia.","tj":[[21,22,0],[22,23,1],[23,26,3],[26,27,17]]},{"s":114,"a":2,"t":"مَلِكِ ٱلنَّاسِ","tr":"Raja manusia.","tj":[[7,8,0],[8,9,1],[9,12,3],[12,13,17]]},{"s":114,"a":3,"t":"إِلَٰهِ ٱلنَّاسِ","tr":"Sembahan manusia.","tj":[[4,5,13],[8,9,0],[9,10,1],[10,13,3],[13,14,17]]},{"s":114,"a":4,"t":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","tr":"Dari kejahatan (bisikan) syaitan yang biasa bersembunyi,","tj":[[2,6,9],[10,11,0],[23,24,0],[28,31,3],[31,32,17]]},{"s":114,"a":5,"t":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","tr":"yang membisikkan (kejahatan) ke dalam dada manusia,","tj":[[31,32,0],[32,33,1],[33,36,3],[36,37,17]]},{"s":114,"a":6,"t":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","tr":"dari (golongan) jin dan manusia.","tj":[[5,6,0],[10,13,3],[18,19,0],[19,20,1],[20,23,3],[23,24,17]]}]